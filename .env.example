# LP Mapping Service - copy to .env and adjust

# Dvara LLM API (when using /api/mapping/auto-map-with-llm)
LLM_BASE_URL=http://localhost:8001
LLM_MODEL_NAME=default
LLM_API_KEY=

# Database

# Option 1: MySQL using separate DB_* vars (recommended)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Option 2: Full SQLAlchemy URL (overrides the above if DB_* not set)
# DATABASE_URL=mysql+pymysql://vivian:vivian123@uat-munify.mmb.perdix.co:9000/munify_db

# Confidence thresholds: auto_map >= 0.85, suggest >= 0.70, below = manual
AUTO_MAP_THRESHOLD=0.85
SUGGEST_THRESHOLD=0.70

DEBUG=false
